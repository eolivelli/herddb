<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>org.herddb</groupId>
        <artifactId>herddb-parent</artifactId>
        <version>0.30.0-SNAPSHOT</version>
        <relativePath>..</relativePath>
    </parent>
    <modelVersion>4.0.0</modelVersion>
    <name>HerdDB Utils</name>
    <artifactId>herddb-utils</artifactId>
    <packaging>jar</packaging>
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>
    <dependencies>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-buffer</artifactId>
        </dependency>
        <dependency>
            <groupId>net.jpountz.lz4</groupId>
            <artifactId>lz4</artifactId>
        </dependency>
    </dependencies>
    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>buildnumber-maven-plugin</artifactId>
                <version>1.4</version>
                <executions>
                    <execution>
                        <phase>validate</phase>
                        <goals>
                            <goal>create</goal>
                        </goals>
                        <configuration>
                            <shortRevisionLength>11</shortRevisionLength>
                            <revisionOnScmFailure>unknown</revisionOnScmFailure>
                        </configuration>
                    </execution>
                </executions>
                <configuration>
                    <shortRevisionLength>11</shortRevisionLength>
                    <revisionOnScmFailure>unknown</revisionOnScmFailure>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <!--
      The historical jdk10 profile that produced a multi-release JAR with
      a JDK-10 variant of CompareBytesUtils / OpenFileUtils under
      META-INF/versions/10/ has been removed. The project now requires
      JDK 11+ (parent pom: maven.compiler.release=17), so the JDK-8 base
      classes were dead code paths and the META-INF/versions/10/
      override was the one being loaded everywhere. The base sources
      have been replaced with what used to live under src/main/java10/
      (Arrays.compareUnsigned / Arrays.equals intrinsics,
      ExtendedOpenOption.DIRECT for O_DIRECT) so we ship a single,
      modern-JDK source set.
    -->
</project>
